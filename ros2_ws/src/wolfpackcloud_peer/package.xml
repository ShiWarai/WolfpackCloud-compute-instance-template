<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wolfpackcloud_peer</name>
  <version>0.1.0</version>
  <description>WolfpackCloud compute peer: symmetric Zenoh pub/sub with RTT (median window) logged to rosout.</description>
  <maintainer email="zhuravliov.pav@yandex.ru">ShiWarai</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>wolfpackcloud_peer_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
